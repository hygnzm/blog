[Unit]
Description=Code Notes Spring Boot API
After=network.target

[Service]
Type=simple
User=codeblog
Group=codeblog
WorkingDirectory=/opt/code-notes/backend
ExecStart=/opt/code-notes/runtime/bin/java -Xms64m -Xmx256m -jar /opt/code-notes/backend/blog-backend-1.0.0.jar
Environment=PORT=8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
